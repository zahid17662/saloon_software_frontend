# Copy to .env.test (gitignored via .env*) and fill in. Used ONLY by `npm run e2e`.
#
# Create a dedicated Neon branch for E2E (for example "e2e", forked from the dev branch so the
# schema and the seeded shop code / admin PIN already exist). NEVER point this at `main`, and do
# not reuse the dev branch: every test run deletes sales, payouts and the whole menu on it.

# Pooled connection string of the E2E branch.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# The endpoint id of that branch (the "ep-..." part of the host, without "-pooler").
# The runner refuses to start unless it matches DATABASE_URL, and refuses if it equals the
# endpoint in .env.local (your dev branch).
E2E_ENDPOINT=ep-xxxxxxxx

# Type the endpoint id again to confirm this branch may be wiped by every test run.
E2E_CONFIRM_RESET=ep-xxxxxxxx

# Optional. Defaults are the demo values the seed creates (1234 / 0000).
# E2E_SHOP_CODE=1234
# E2E_ADMIN_PIN=0000
