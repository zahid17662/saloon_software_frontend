# Copy to .env.local and fill in real values. Never commit .env.local.
# On Vercel set these in Project Settings -> Environment Variables.

# Base URL of the backend API (the Render service), no trailing slash.
API_URL=https://salon-api.onrender.com

# Shared secret with the API (at least 32 characters). Generate with: openssl rand -base64 32
# MUST be identical to API_KEY on the Render service. Server-side only: never prefix it NEXT_PUBLIC_.
API_KEY=

# Secret for verifying session cookies in proxy.ts (convenience redirects only; the API does the real
# check). MUST be identical to SESSION_SECRET on the Render service. Generate with: openssl rand -base64 32
SESSION_SECRET=
